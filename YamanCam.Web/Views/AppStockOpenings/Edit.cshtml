@model YamanCam.Web.Models.AppStockOpeningEditViewModel
@using YamanCam.Web.Services
@{
    var isNew = Model.RecId == 0;
    ViewData["Title"] = isNew ? "Yeni Stok Açılış Fişi" : "Stok Açılış Fişi Düzenle";
    var stockOptionsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.StockOptions.Select(o => new { value = o.Value, text = o.Text }));
    var stockUnitOptionsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.StockUnitOptions.Select(o => new { value = o.Value, text = o.Text }));
    var stockUnits = ViewData["StockUnits"] as Dictionary<string, string> ?? new Dictionary<string, string>();
    var stockUnitsJson = System.Text.Json.JsonSerializer.Serialize(stockUnits);

    var kusurat = ViewData["Kusurat"] as IReadOnlyDictionary<string, int>;
    int Dec(string key) => NumberFormatHelper.Get(kusurat, key);
    var qtyDec = Dec("Yeni Stok Açılış Fişi Adet");
    var priceDec = Dec("Yeni Stok Açılış Fişi Birim Fiyat");
    var totalDec = Dec("Yeni Stok Açılış Fişi Toplam Fiyat");
    var genelToplamDec = Dec("Yeni Stok Açılış Fişi Genel Toplam");
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form asp-action="@(isNew ? "Create" : "Edit")" method="post" id="stockOpeningForm">
            @Html.AntiForgeryToken()
            <input asp-for="RecId" type="hidden" />

            <div class="d-flex justify-content-between align-items-start mb-3">
                <h1 class="h4 mb-0">@ViewData["Title"]</h1>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <h2 class="h6 text-muted mb-3">Fiş Bilgileri</h2>
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="VoucherDate" class="form-label"></label>
                    <input asp-for="VoucherDate" type="date" class="form-control" asp-format="{0:yyyy-MM-dd}" />
                    <span asp-validation-for="VoucherDate" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="WorkPlaceId" class="form-label"></label>
                    <select asp-for="WorkPlaceId" asp-items="Model.WorkPlaceOptions" class="form-select">
                        <option value="">Seçiniz</option>
                    </select>
                    <span asp-validation-for="WorkPlaceId" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="TransactionType" class="form-label"></label>
                    <select asp-for="TransactionType" asp-items="Model.TransactionTypeOptions" class="form-select"></select>
                    <span asp-validation-for="TransactionType" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="VoucherNo" class="form-label"></label>
                    <input asp-for="VoucherNo" class="form-control" />
                    <span asp-validation-for="VoucherNo" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="SpecialCode" class="form-label"></label>
                    <input asp-for="SpecialCode" class="form-control" />
                    <span asp-validation-for="SpecialCode" class="text-danger"></span>
                </div>
            </div>

            <h2 class="h6 text-muted mt-4 mb-3">Stok Satırları</h2>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-2" id="linesTable">
                    <thead>
                        <tr>
                            <th style="min-width:240px;">Stok Adı</th>
                            <th style="min-width:160px;">Stok Birim</th>
                            <th style="width:120px;" class="text-end">Adet</th>
                            <th style="width:130px;" class="text-end">Birim Fiyat</th>
                            <th style="width:140px;" class="text-end">Toplam Fiyat</th>
                            <th style="width:50px;"></th>
                        </tr>
                    </thead>
                    <tbody id="linesBody">
                        @for (var i = 0; i < Model.Lines.Count; i++)
                        {
                            <tr class="line-row">
                                <td>
                                    <input type="hidden" name="Lines[@i].RecId" value="@Model.Lines[i].RecId" />
                                    <select name="Lines[@i].StockId" class="form-select form-select-sm line-stock">
                                        <option value="0">Seçiniz</option>
                                        @foreach (var opt in Model.StockOptions)
                                        {
                                            <option value="@opt.Value" selected="@(opt.Value == Model.Lines[i].StockId.ToString() ? "selected" : null)">@opt.Text</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <select name="Lines[@i].StockUnitId" class="form-select form-select-sm line-unit">
                                        <option value="">Seçiniz</option>
                                        @foreach (var opt in Model.StockUnitOptions)
                                        {
                                            <option value="@opt.Value" selected="@(opt.Value == Model.Lines[i].StockUnitId?.ToString() ? "selected" : null)">@opt.Text</option>
                                        }
                                    </select>
                                </td>
                                <td><input type="number" step="@NumberFormatHelper.Step(qtyDec)" min="0" name="Lines[@i].Quantity" class="form-control form-control-sm text-end line-qty" value="@Model.Lines[i].Quantity" /></td>
                                <td><input type="number" step="@NumberFormatHelper.Step(priceDec)" min="0" name="Lines[@i].UnitPrice" class="form-control form-control-sm text-end line-price" value="@Model.Lines[i].UnitPrice" /></td>
                                <td><input type="number" step="@NumberFormatHelper.Step(totalDec)" min="0" name="Lines[@i].TotalPrice" class="form-control form-control-sm text-end line-total" value="@Model.Lines[i].TotalPrice" /></td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-outline-danger line-remove">&times;</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="d-flex gap-2 mb-4">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="addLineBtn">Satır Ekle</button>
                <button type="button" class="btn btn-sm btn-outline-danger" id="removeLastLineBtn">Satır Sil</button>
            </div>

            <h2 class="h6 text-muted mt-4 mb-3">Fiş Toplamı</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="border rounded p-3">
                        <div class="d-flex justify-content-between fw-bold"><span>Genel Toplam</span><span id="totalAmount">0,00</span></div>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </form>

        @if (!isNew)
        {
            <form asp-action="Delete" asp-route-id="@Model.RecId" method="post" class="mt-3 pt-3 border-top">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="btn btn-outline-danger"
                        onclick="return confirm('Bu fişi silmek istediğinize emin misiniz?');">
                    Fişi Sil
                </button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var linesBody = document.getElementById('linesBody');
            var addBtn = document.getElementById('addLineBtn');
            var removeLastBtn = document.getElementById('removeLastLineBtn');
            var stockOptions = @Html.Raw(stockOptionsJson);
            var stockUnitOptions = @Html.Raw(stockUnitOptionsJson);
            var stockUnits = @Html.Raw(stockUnitsJson);

            var qtyStep = '@NumberFormatHelper.Step(qtyDec)';
            var priceStep = '@NumberFormatHelper.Step(priceDec)';
            var totalStep = '@NumberFormatHelper.Step(totalDec)';
            var genelToplamDec = @genelToplamDec;

            function formatAmount(value, decimals) {
                var d = (decimals === undefined || decimals === null) ? 2 : decimals;
                return value.toLocaleString('tr-TR', { minimumFractionDigits: d, maximumFractionDigits: d });
            }

            function buildStockOptionsHtml() {
                var html = '<option value="0">Seçiniz</option>';
                stockOptions.forEach(function (opt) {
                    html += '<option value="' + opt.value + '">' + opt.text + '</option>';
                });
                return html;
            }

            function buildStockUnitOptionsHtml() {
                var html = '<option value="">Seçiniz</option>';
                stockUnitOptions.forEach(function (opt) {
                    html += '<option value="' + opt.value + '">' + opt.text + '</option>';
                });
                return html;
            }

            function reindex() {
                var rows = linesBody.querySelectorAll('tr.line-row');
                rows.forEach(function (row, idx) {
                    row.querySelectorAll('[name]').forEach(function (el) {
                        el.name = el.name.replace(/Lines\[\d+\]/, 'Lines[' + idx + ']');
                    });
                });
            }

            function roundValue(value) {
                return Math.round(value * 10000) / 10000;
            }

            function recalcRow(row) {
                var qty = parseFloat(row.querySelector('.line-qty').value) || 0;
                var price = parseFloat(row.querySelector('.line-price').value) || 0;
                var total = qty * price;
                row.querySelector('.line-total').value = roundValue(total);
                return total;
            }

            function recalcRowFromTotal(row) {
                var total = parseFloat(row.querySelector('.line-total').value) || 0;
                var qty = parseFloat(row.querySelector('.line-qty').value) || 0;

                if (qty) {
                    row.querySelector('.line-price').value = roundValue(total / qty);
                }
            }

            function updateSummary() {
                var totalAmount = 0;

                linesBody.querySelectorAll('tr.line-row').forEach(function (row) {
                    totalAmount += parseFloat(row.querySelector('.line-total').value) || 0;
                });

                document.getElementById('totalAmount').textContent = formatAmount(totalAmount, genelToplamDec);
            }

            function recalcAll() {
                linesBody.querySelectorAll('tr.line-row').forEach(recalcRow);
                updateSummary();
            }

            function bindRowEvents(row) {
                row.querySelectorAll('.line-qty, .line-price').forEach(function (el) {
                    el.addEventListener('input', function () {
                        recalcRow(row);
                        updateSummary();
                    });
                });

                row.querySelector('.line-total').addEventListener('input', function () {
                    recalcRowFromTotal(row);
                    updateSummary();
                });

                row.querySelector('.line-stock').addEventListener('change', function () {
                    var unitId = stockUnits[this.value];
                    if (unitId !== undefined) {
                        row.querySelector('.line-unit').value = unitId;
                    }
                });

                row.querySelector('.line-remove').addEventListener('click', function () {
                    if (linesBody.querySelectorAll('tr.line-row').length <= 1) return;
                    row.remove();
                    reindex();
                    updateSummary();
                });
            }

            function addRow() {
                var idx = linesBody.querySelectorAll('tr.line-row').length;
                var tr = document.createElement('tr');
                tr.className = 'line-row';
                tr.innerHTML =
                    '<td><input type="hidden" name="Lines[' + idx + '].RecId" value="0" />' +
                    '<select name="Lines[' + idx + '].StockId" class="form-select form-select-sm line-stock">' + buildStockOptionsHtml() + '</select></td>' +
                    '<td><select name="Lines[' + idx + '].StockUnitId" class="form-select form-select-sm line-unit">' + buildStockUnitOptionsHtml() + '</select></td>' +
                    '<td><input type="number" step="' + qtyStep + '" min="0" name="Lines[' + idx + '].Quantity" class="form-control form-control-sm text-end line-qty" value="0" /></td>' +
                    '<td><input type="number" step="' + priceStep + '" min="0" name="Lines[' + idx + '].UnitPrice" class="form-control form-control-sm text-end line-price" value="0" /></td>' +
                    '<td><input type="number" step="' + totalStep + '" min="0" name="Lines[' + idx + '].TotalPrice" class="form-control form-control-sm text-end line-total" value="0" /></td>' +
                    '<td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger line-remove">&times;</button></td>';
                linesBody.appendChild(tr);
                bindRowEvents(tr);
                recalcAll();
            }

            linesBody.querySelectorAll('tr.line-row').forEach(bindRowEvents);
            addBtn.addEventListener('click', addRow);
            removeLastBtn.addEventListener('click', function () {
                var rows = linesBody.querySelectorAll('tr.line-row');
                if (rows.length <= 1) return;
                rows[rows.length - 1].remove();
                reindex();
                updateSummary();
            });

            recalcAll();
        })();
    </script>
}
