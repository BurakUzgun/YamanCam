@model YamanCam.Web.Models.AppStockGroupEditViewModel
@{
    var isNew = Model.RecId == 0;
    ViewData["Title"] = isNew ? "Yeni Stok Grubu" : "Stok Grubu Düzenle";
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form asp-action="@(isNew ? "Create" : "Edit")" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="RecId" type="hidden" />

            <div class="d-flex justify-content-between align-items-start mb-3">
                <h1 class="h4 mb-0">@ViewData["Title"]</h1>
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="IsActive" name="IsActive" value="true" @(Model.IsActive ? "checked" : "") />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <h2 class="h6 text-muted mb-3">Stok Grup Bilgileri</h2>
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="GroupCode" class="form-label"></label>
                    <input asp-for="GroupCode" class="form-control" />
                    <span asp-validation-for="GroupCode" class="text-danger"></span>
                </div>
                <div class="col-md-9">
                    <label asp-for="GroupName" class="form-label"></label>
                    <input asp-for="GroupName" class="form-control" />
                    <span asp-validation-for="GroupName" class="text-danger"></span>
                </div>
            </div>

            <h2 class="h6 text-muted mt-4 mb-3">Muhasebe Kodları</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="PurchaseAccountCode" class="form-label"></label>
                    <select asp-for="PurchaseAccountCode" asp-items="Model.AccountCodeOptions" class="form-select">
                        <option value="">Seçiniz</option>
                    </select>
                    <span asp-validation-for="PurchaseAccountCode" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="SalesAccountCode" class="form-label"></label>
                    <select asp-for="SalesAccountCode" asp-items="Model.AccountCodeOptions" class="form-select">
                        <option value="">Seçiniz</option>
                    </select>
                    <span asp-validation-for="SalesAccountCode" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </form>

        @if (!isNew)
        {
            <form asp-action="Delete" asp-route-id="@Model.RecId" method="post" class="mt-3 pt-3 border-top">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="btn btn-outline-danger"
                        onclick="return confirm('Bu stok grubunu silmek istediğinize emin misiniz?');">
                    Stok Grubunu Sil
                </button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
