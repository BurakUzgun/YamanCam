@using YamanCam.Web.Services
@inject IUserRightService UserRightService
@{
    var allowedScreenCodes = await UserRightService.GetAllowedScreenCodesAsync(User);
    bool Allowed(string code) => allowedScreenCodes.Contains(code);
    var showTanimlar = Allowed("AppCompanies") || Allowed("AppWorkPlaces") || Allowed("AppVatDefinitions") || Allowed("AppVatWithholdingDefinitions");
    var showFaturalar = Allowed("AppPurchaseInvoices") || Allowed("AppSalesInvoices") || Allowed("AppCustomsFreightInvoices");
    var showMuhasebeIslemleri = Allowed("AppPaymentVouchers") || Allowed("AppReceiptVouchers") || Allowed("AppJournalVouchers");
    var showMuhasebe = Allowed("AppAccountPlans") || showFaturalar || showMuhasebeIslemleri;
}
@* AnaMenu.dfm — sol agac menusu (yalnizca yapi, icerik henuz baglanmadi) *@

<nav class="app-menu-tree" aria-label="Ana menu">
    <a class="app-menu-link app-menu-link-root" asp-controller="Home" asp-action="Index">Ana Sayfa</a>

  <div class="app-menu-group">
    <button class="app-menu-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#menuSistem" aria-expanded="false">
      Sistem
    </button>
    <ul class="collapse app-menu-sub" id="menuSistem">
      <li><a class="app-menu-link" asp-controller="Account" asp-action="ChangePassword">Sifre Degistir</a></li>
      @if (Allowed("AppUsers"))
      {
        <li><a class="app-menu-link" asp-controller="AppUsers" asp-action="Index">Kullanıcı Tanımları</a></li>
      }
      <li><a class="app-menu-link" asp-controller="AppLogs" asp-action="Index">Log Kayıt İzleme</a></li>
      @if (showTanimlar)
      {
        <li class="app-menu-group">
          <button class="app-menu-toggle app-menu-toggle-sub" type="button" data-bs-toggle="collapse" data-bs-target="#menuSistemTanimlar" aria-expanded="false">
            Tanimlar
          </button>
          <ul class="collapse app-menu-sub" id="menuSistemTanimlar">
            @if (Allowed("AppCompanies"))
            {
              <li><a class="app-menu-link" asp-controller="AppCompanies" asp-action="Index">Şirket Tanımları</a></li>
            }
            @if (Allowed("AppWorkPlaces"))
            {
              <li><a class="app-menu-link" asp-controller="AppWorkPlaces" asp-action="Index">Şube Tanımları</a></li>
            }
            @if (Allowed("AppVatDefinitions"))
            {
              <li><a class="app-menu-link" asp-controller="AppVatDefinitions" asp-action="Index">Kdv Tanimlari</a></li>
            }
            @if (Allowed("AppVatWithholdingDefinitions"))
            {
              <li><a class="app-menu-link" asp-controller="AppVatWithholdingDefinitions" asp-action="Index">Tevkifat Kdv Tanimlari</a></li>
            }
          </ul>
        </li>
      }
    </ul>
  </div>

  <div class="app-menu-group">
    <button class="app-menu-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#menuStok" aria-expanded="false">
      Stok
    </button>
    <ul class="collapse app-menu-sub" id="menuStok">
      @if (Allowed("AppStocks"))
      {
        <li><a class="app-menu-link" asp-controller="AppStocks" asp-action="Index">Stoklar</a></li>
      }
      <li class="app-menu-group">
        <button class="app-menu-toggle app-menu-toggle-sub" type="button" data-bs-toggle="collapse" data-bs-target="#menuStokTanimlar" aria-expanded="false">
          Stok Tanimlar
        </button>
        <ul class="collapse app-menu-sub" id="menuStokTanimlar">
          @if (Allowed("AppStockGroups"))
          {
            <li><a class="app-menu-link" asp-controller="AppStockGroups" asp-action="Index">Stok Gruplari</a></li>
          }
          <li><a class="app-menu-link" href="#">Stok Ek Bilgiler</a></li>
          @if (Allowed("AppStockUnits"))
          {
            <li><a class="app-menu-link" asp-controller="AppStockUnits" asp-action="Index">Stok Birimleri</a></li>
          }
          @if (Allowed("AppProductionDefinitions"))
          {
            <li><a class="app-menu-link" asp-controller="AppProductionDefinitions" asp-action="Index">Uretim Tanimlari</a></li>
          }
        </ul>
      </li>
      <li class="app-menu-group">
        <button class="app-menu-toggle app-menu-toggle-sub" type="button" data-bs-toggle="collapse" data-bs-target="#menuStokIslemler" aria-expanded="false">
          Stok Islemleri
        </button>
        <ul class="collapse app-menu-sub" id="menuStokIslemler">
          @if (Allowed("AppStockOpenings"))
          {
            <li><a class="app-menu-link" asp-controller="AppStockOpenings" asp-action="Index">Acilis Fisleri</a></li>
          }
          @if (Allowed("AppStockTransfers"))
          {
            <li><a class="app-menu-link" asp-controller="AppStockTransfers" asp-action="Index">Subeler Arasi Transfer Fisleri</a></li>
          }
          <li><a class="app-menu-link" href="#">Cikis Fisleri</a></li>
          <li><a class="app-menu-link" href="#">Uretim</a></li>
          <li><a class="app-menu-link" href="#">Sayim Islemleri</a></li>
          <li><a class="app-menu-link" href="#">Yonetim Gideri Stok Dagitimi</a></li>
          @if (Allowed("AppStockMerges"))
          {
            <li><a class="app-menu-link" asp-controller="AppStockMerges" asp-action="Index">Stoklari Birlestir</a></li>
          }
          <li><a class="app-menu-link" href="#">Subeler Arasi Transfer Farkli Urun</a></li>
        </ul>
      </li>
    </ul>
  </div>

  @if (showMuhasebe)
  {
  <div class="app-menu-group">
    <button class="app-menu-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#menuMuhasebe" aria-expanded="false">
      Muhasebe
    </button>
    <ul class="collapse app-menu-sub" id="menuMuhasebe">
      @if (Allowed("AppAccountPlans"))
      {
        <li><a class="app-menu-link" asp-controller="AppAccountPlans" asp-action="Index">Hesap Plani</a></li>
      }
      @if (showFaturalar)
      {
        <li class="app-menu-group">
          <button class="app-menu-toggle app-menu-toggle-sub" type="button" data-bs-toggle="collapse" data-bs-target="#menuMuhasebeFaturalar" aria-expanded="false">
            Faturalar
          </button>
          <ul class="collapse app-menu-sub" id="menuMuhasebeFaturalar">
            @if (Allowed("AppPurchaseInvoices"))
            {
              <li><a class="app-menu-link" asp-controller="AppPurchaseInvoices" asp-action="Index">Alis Faturalari</a></li>
            }
            @if (Allowed("AppSalesInvoices"))
            {
              <li><a class="app-menu-link" asp-controller="AppSalesInvoices" asp-action="Index">Satis Faturalari</a></li>
            }
            @if (Allowed("AppCustomsFreightInvoices"))
            {
              <li><a class="app-menu-link" asp-controller="AppCustomsFreightInvoices" asp-action="Index">Gumruk Nakliye Faturalari</a></li>
            }
          </ul>
        </li>
      }
      @if (showMuhasebeIslemleri)
      {
        <li class="app-menu-group">
          <button class="app-menu-toggle app-menu-toggle-sub" type="button" data-bs-toggle="collapse" data-bs-target="#menuMuhasebeIslemler" aria-expanded="false">
            Muhasebe Islemleri
          </button>
          <ul class="collapse app-menu-sub" id="menuMuhasebeIslemler">
            @if (Allowed("AppPaymentVouchers"))
            {
              <li><a class="app-menu-link" asp-controller="AppPaymentVouchers" asp-action="Index">Tediye Fisi</a></li>
            }
            @if (Allowed("AppReceiptVouchers"))
            {
              <li><a class="app-menu-link" asp-controller="AppReceiptVouchers" asp-action="Index">Tahsilat Fisi</a></li>
            }
            @if (Allowed("AppJournalVouchers"))
            {
              <li><a class="app-menu-link" asp-controller="AppJournalVouchers" asp-action="Index">Mahsup Fisi</a></li>
            }
          </ul>
        </li>
      }
    </ul>
  </div>
  }

  <div class="app-menu-group">
    <button class="app-menu-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#menuRaporlar" aria-expanded="false">
      Raporlar
    </button>
    <ul class="collapse app-menu-sub" id="menuRaporlar">
      <li class="app-menu-group">
        <button class="app-menu-toggle app-menu-toggle-sub" type="button" data-bs-toggle="collapse" data-bs-target="#menuRaporStok" aria-expanded="false">
          Stok Raporlari
        </button>
        <ul class="collapse app-menu-sub" id="menuRaporStok">
          <li><a class="app-menu-link" href="#">Stok Hareketleri</a></li>
          <li><a class="app-menu-link" href="#">Donem Sonu Raporu Birim</a></li>
          <li><a class="app-menu-link" href="#">Donem Sonu Raporu Birim Eksiler</a></li>
          <li><a class="app-menu-link" href="#">Donem Sonu Birim Uretim Maliyet</a></li>
          <li><a class="app-menu-link" href="#">Donem Sonu Birim Uretim Maliyet Tumu</a></li>
        </ul>
      </li>
      <li class="app-menu-group">
        <button class="app-menu-toggle app-menu-toggle-sub" type="button" data-bs-toggle="collapse" data-bs-target="#menuRaporCari" aria-expanded="false">
          Cari Raporlar
        </button>
        <ul class="collapse app-menu-sub" id="menuRaporCari">
          <li><a class="app-menu-link" href="#">Cari Extre</a></li>
        </ul>
      </li>
      <li class="app-menu-group">
        <button class="app-menu-toggle app-menu-toggle-sub" type="button" data-bs-toggle="collapse" data-bs-target="#menuRaporMuhasebe" aria-expanded="false">
          Muhasebe Raporlari
        </button>
        <ul class="collapse app-menu-sub" id="menuRaporMuhasebe">
          <li class="app-menu-group">
            <button class="app-menu-toggle app-menu-toggle-sub" type="button" data-bs-toggle="collapse" data-bs-target="#menuRaporMuhasebeFis" aria-expanded="false">
              Muhasebe Fisleri
            </button>
            <ul class="collapse app-menu-sub" id="menuRaporMuhasebeFis">
              <li><a class="app-menu-link" href="#">Mahsup Fisleri</a></li>
              <li><a class="app-menu-link" href="#">Tahsilat Fisleri</a></li>
              <li><a class="app-menu-link" href="#">Tediye Fisleri</a></li>
