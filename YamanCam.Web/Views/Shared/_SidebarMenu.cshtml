          </li>
          <li class="app-menu-group">
            <button class="app-menu-toggle app-menu-toggle-sub" type="button" data-bs-toggle="collapse" data-bs-target="#menuRaporFatura" aria-expanded="false">
              Fatura Raporlari
            </button>
            <ul class="collapse app-menu-sub" id="menuRaporFatura">
              <li><a class="app-menu-link" href="#">Alis Faturalari</a></li>
              <li><a class="app-menu-link" href="#">Satis Faturalari</a></li>
              <li><a class="app-menu-link" href="#">Gumruk Nakliye Faturalari</a></li>
            </ul>
          </li>
        </ul>
      </li>
      <li class="app-menu-group">
        <button class="app-menu-toggle app-menu-toggle-sub" type="button" data-bs-toggle="collapse" data-bs-target="#menuRaporMizan" aria-expanded="false">
          Mizan Raporlari
        </button>
        <ul class="collapse app-menu-sub" id="menuRaporMizan">
          <li><a class="app-menu-link" href="#">Mizan</a></li>
        </ul>
      </li>
      <li class="app-menu-group">
        <button class="app-menu-toggle app-menu-toggle-sub" type="button" data-bs-toggle="collapse" data-bs-target="#menuRaporDonemSonu" aria-expanded="false">
          Donem Sonu Raporlari
        </button>
        <ul class="collapse app-menu-sub" id="menuRaporDonemSonu">
          <li><a class="app-menu-link" href="#">Stok Durum</a></li>
        </ul>
      </li>
    </ul>
  </div>
</nav>
