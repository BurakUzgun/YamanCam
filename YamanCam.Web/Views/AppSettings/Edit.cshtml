@model YamanCam.Web.Models.AppSettingEditViewModel
@{
    var isNew = Model.RecId == 0;
    ViewData["Title"] = isNew ? "Yeni Ayar" : "Ayar Düzenle";
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form asp-action="@(isNew ? "Create" : "Edit")" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="RecId" type="hidden" />

            <div class="d-flex justify-content-between align-items-start mb-3">
                <h1 class="h4 mb-0">@ViewData["Title"]</h1>
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="IsActive" name="IsActive" value="true" @(Model.IsActive ? "checked" : "") />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <h2 class="h6 text-muted mb-3">Ayar Bilgileri</h2>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="SettingGroup" class="form-label"></label>
                    <input asp-for="SettingGroup" class="form-control" placeholder="Küsürat" />
                    <span asp-validation-for="SettingGroup" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Explanation" class="form-label"></label>
                    <input asp-for="Explanation" class="form-control" placeholder="Alış Faturaları Kur" />
                    <span asp-validation-for="Explanation" class="text-danger"></span>
                </div>
                <div class="col-md-2">
                    <label asp-for="Value" class="form-label"></label>
                    <input asp-for="Value" class="form-control" type="text" />
                    <span asp-validation-for="Value" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </form>

        @if (!isNew)
        {
            <form asp-action="Delete" asp-route-id="@Model.RecId" method="post" class="mt-3 pt-3 border-top">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="btn btn-outline-danger"
                        onclick="return confirm('Bu ayarı silmek istediğinize emin misiniz?');">
                    Ayarı Sil
                </button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
