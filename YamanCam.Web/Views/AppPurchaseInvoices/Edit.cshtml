@model YamanCam.Web.Models.AppPurchaseInvoiceEditViewModel
@using System.Globalization
@using YamanCam.Web.Services
@{
    var isNew = Model.RecId == 0;
    ViewData["Title"] = isNew ? "Yeni Alış Faturası" : "Alış Faturası Düzenle";
    var stockOptionsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.StockOptions.Select(o => new { value = o.Value, text = o.Text }));
    var stockVatRates = ViewData["StockVatRates"] as Dictionary<string, decimal> ?? new Dictionary<string, decimal>();
    var stockVatRatesJson = System.Text.Json.JsonSerializer.Serialize(stockVatRates);
    var withholdingDefinitionOptionsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.WithholdingDefinitionOptions.Select(o => new { value = o.Value, text = o.Text }));
    var withholdingRates = ViewData["WithholdingDefinitionRates"] as Dictionary<string, decimal> ?? new Dictionary<string, decimal>();
    var withholdingRatesJson = System.Text.Json.JsonSerializer.Serialize(withholdingRates);

    var kusurat = ViewData["Kusurat"] as IReadOnlyDictionary<string, int>;
    int Dec(string key) => NumberFormatHelper.Get(kusurat, key);
    var kurDec = Dec("Alış Faturaları Kur");
    var qtyDec = Dec("Yeni Alış Faturası Miktar");
    var priceDec = Dec("Yeni Alış Faturası Birim Fiyat");
    var vatRateDec = Dec("Yeni Alış Faturası KDV %");
    var withholdingRateDec = Dec("Yeni Alış Faturası Tev. %");
    var netDec = Dec("Yeni Alış Faturası Net (Döviz)");
    var vatDec = Dec("Yeni Alış Faturası KDV (Döviz)");
    var withholdingDec = Dec("Yeni Alış Faturası Tevkifat");
    var netVatDec = Dec("Yeni Alış Faturası Net KDV");
    var totalDec = Dec("Yeni Alış Faturası Toplam (Döviz)");
    var malBedeliDec = Dec("Yeni Alış Faturası Mal Bedeli");
    var genelToplamDec = Dec("Yeni Alış Faturası Genel Toplam");
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form asp-action="@(isNew ? "Create" : "Edit")" method="post" id="purchaseInvoiceForm">
            @Html.AntiForgeryToken()
            <input asp-for="RecId" type="hidden" />

            <div class="d-flex justify-content-between align-items-start mb-3">
                <h1 class="h4 mb-0">@ViewData["Title"]</h1>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <h2 class="h6 text-muted mb-3">Fatura Bilgileri</h2>
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="InvoiceNo" class="form-label"></label>
                    <input asp-for="InvoiceNo" class="form-control" />
                    <span asp-validation-for="InvoiceNo" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="InvoiceDate" class="form-label"></label>
                    <input asp-for="InvoiceDate" type="date" class="form-control" asp-format="{0:yyyy-MM-dd}" />
                    <span asp-validation-for="InvoiceDate" class="text-danger"></span>
                </div>
                <div class="col-md-2">
                    <label asp-for="CurrencyCode" class="form-label"></label>
                    <select asp-for="CurrencyCode" id="currencyCodeSelect" class="form-select">
                        <option value="TRY">TRY</option>
                        <option value="USD">USD</option>
                        <option value="EUR">EUR</option>
                        <option value="GBP">GBP</option>
                    </select>
                    <span asp-validation-for="CurrencyCode" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="ExchangeRate" class="form-label"></label>
                    <input asp-for="ExchangeRate" id="exchangeRateInput" type="number" step="@NumberFormatHelper.Step(kurDec)" min="0.0001" class="form-control" />
                    <span asp-validation-for="ExchangeRate" class="text-danger"></span>
                    <div class="form-text">TRY seçiliyken kur otomatik olarak 1 kabul edilir.</div>
                </div>
                <div class="col-md-4">
                    <label asp-for="AccountId" class="form-label"></label>
                    <select asp-for="AccountId" asp-items="Model.AccountOptions" class="form-select">
                        <option value="">Seçiniz</option>
                    </select>
                    <span asp-validation-for="AccountId" class="text-danger"></span>
                    <div class="form-text">Hesap tipi "Cari" olan muhasebe hesap kartları listelenir.</div>
                </div>
                <div class="col-md-4">
                    <label asp-for="CompanyId" class="form-label"></label>
                    <select asp-for="CompanyId" asp-items="Model.CompanyOptions" class="form-select">
                        <option value="">Seçiniz</option>
                    </select>
                    <span asp-validation-for="CompanyId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="WorkPlaceId" class="form-label"></label>
                    <select asp-for="WorkPlaceId" asp-items="Model.WorkPlaceOptions" class="form-select">
                        <option value="">Seçiniz</option>
                    </select>
                    <span asp-validation-for="WorkPlaceId" class="text-danger"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="Description" class="form-label"></label>
                    <input asp-for="Description" class="form-control" />
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>

            <h2 class="h6 text-muted mt-4 mb-3">Malzeme Satırları</h2>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-2" id="linesTable">
                    <thead>
                        <tr>
                            <th style="min-width:240px;">Malzeme</th>
                            <th style="min-width:160px;">Açıklama</th>
                            <th style="width:110px;" class="text-end">Miktar</th>
                            <th style="width:120px;" class="text-end">Birim Fiyat</th>
                            <th style="width:90px;" class="text-end">KDV %</th>
                            <th style="min-width:200px;">Tevkifat</th>
                            <th style="width:90px;" class="text-end">Tev. %</th>
                            <th style="width:120px;" class="text-end">Net (Döviz)</th>
                            <th style="width:110px;" class="text-end">KDV (Döviz)</th>
                            <th style="width:110px;" class="text-end">Tevkifat</th>
                            <th style="width:110px;" class="text-end">Net KDV</th>
                            <th style="width:120px;" class="text-end">Toplam (Döviz)</th>
                            <th style="width:50px;"></th>
                        </tr>
                    </thead>
                    <tbody id="linesBody">
                        @for (var i = 0; i < Model.Lines.Count; i++)
                        {
                            <tr class="line-row">
                                <td>
                                    <input type="hidden" name="Lines[@i].RecId" value="@Model.Lines[i].RecId" />
                                    <select name="Lines[@i].StockId" class="form-select form-select-sm line-stock">
                                        <option value="0">Seçiniz</option>
                                        @foreach (var opt in Model.StockOptions)
                                        {
                                            <option value="@opt.Value" selected="@(opt.Value == Model.Lines[i].StockId.ToString() ? "selected" : null)">@opt.Text</option>
                                        }
                                    </select>
                                </td>
                                <td><input type="text" name="Lines[@i].Description" class="form-control form-control-sm" value="@Model.Lines[i].Description" /></td>
                                <td><input type="number" step="@NumberFormatHelper.Step(qtyDec)" min="0" name="Lines[@i].Quantity" class="form-control form-control-sm text-end line-qty" value="@Model.Lines[i].Quantity.ToString(CultureInfo.InvariantCulture)" /></td>
                                <td><input type="number" step="@NumberFormatHelper.Step(priceDec)" min="0" name="Lines[@i].UnitPrice" class="form-control form-control-sm text-end line-price" value="@Model.Lines[i].UnitPrice.ToString(CultureInfo.InvariantCulture)" /></td>
                                <td><input type="number" step="@NumberFormatHelper.Step(vatRateDec)" min="0" name="Lines[@i].VatRate" class="form-control form-control-sm text-end line-vatrate" value="@Model.Lines[i].VatRate.ToString(CultureInfo.InvariantCulture)" /></td>
                                <td>
                                    <select name="Lines[@i].WithholdingDefinitionId" class="form-select form-select-sm line-withholding-select">
                                        <option value="">Yok</option>
                                        @foreach (var opt in Model.WithholdingDefinitionOptions)
                                        {
                                            <option value="@opt.Value" selected="@(opt.Value == Model.Lines[i].WithholdingDefinitionId?.ToString() ? "selected" : null)">@opt.Text</option>
                                        }
                                    </select>
                                </td>
                                <td><input type="number" step="@NumberFormatHelper.Step(withholdingRateDec)" min="0" max="100" name="Lines[@i].WithholdingRate" class="form-control form-control-sm text-end line-withholding-rate" value="@Model.Lines[i].WithholdingRate.ToString(CultureInfo.InvariantCulture)" /></td>
                                <td class="text-end line-net">0,00</td>
                                <td class="text-end line-vat">0,00</td>
                                <td class="text-end line-withholding-amount">0,00</td>
                                <td class="text-end line-net-vat">0,00</td>
                                <td><input type="number" step="@NumberFormatHelper.Step(totalDec)" min="0" class="form-control form-control-sm text-end line-total" value="0" /></td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-outline-danger line-remove">&times;</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary mb-4" id="addLineBtn">+ Satır Ekle</button>

            <h2 class="h6 text-muted mt-4 mb-3">Fatura Toplamları</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="border rounded p-3">
                        <div class="text-muted small mb-2">Döviz (<span id="currencyLabel">TRY</span>)</div>
                        <div class="d-flex justify-content-between"><span>Mal Bedeli</span><span id="totalNet">0,00</span></div>
                        <div class="d-flex justify-content-between"><span>KDV</span><span id="totalVat">0,00</span></div>
                        <div class="d-flex justify-content-between"><span>Tevkifat</span><span id="totalWithholding">0,00</span></div>
                        <div class="d-flex justify-content-between"><span>Net KDV</span><span id="totalNetVat">0,00</span></div>
                        <div class="d-flex justify-content-between fw-bold border-top mt-2 pt-2"><span>Genel Toplam</span><span id="totalGross">0,00</span></div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="border rounded p-3">
                        <div class="text-muted small mb-2">TL Karşılığı</div>
                        <div class="d-flex justify-content-between"><span>Mal Bedeli</span><span id="totalNetTry">0,00</span></div>
                        <div class="d-flex justify-content-between"><span>KDV</span><span id="totalVatTry">0,00</span></div>
                        <div class="d-flex justify-content-between"><span>Tevkifat</span><span id="totalWithholdingTry">0,00</span></div>
                        <div class="d-flex justify-content-between"><span>Net KDV</span><span id="totalNetVatTry">0,00</span></div>
                        <div class="d-flex justify-content-between fw-bold border-top mt-2 pt-2"><span>Genel Toplam</span><span id="totalGrossTry">0,00</span></div>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </form>

        @if (!isNew)
        {
            <form asp-action="Delete" asp-route-id="@Model.RecId" method="post" class="mt-3 pt-3 border-top">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="btn btn-outline-danger"
                        onclick="return confirm('Bu faturayı silmek istediğinize emin misiniz?');">
                    Faturayı Sil
                </button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var linesBody = document.getElementById('linesBody');
            var addBtn = document.getElementById('addLineBtn');
            var currencySelect = document.getElementById('currencyCodeSelect');
            var exchangeRateInput = document.getElementById('exchangeRateInput');
            var currencyLabel = document.getElementById('currencyLabel');
            var stockOptions = @Html.Raw(stockOptionsJson);
            var stockVatRates = @Html.Raw(stockVatRatesJson);
            var withholdingOptions = @Html.Raw(withholdingDefinitionOptionsJson);
            var withholdingRates = @Html.Raw(withholdingRatesJson);

            var kusuratDecimals = {
                net: @netDec,
                vat: @vatDec,
                withholding: @withholdingDec,
                netVat: @netVatDec,
                total: @totalDec,
                malBedeli: @malBedeliDec,
                genelToplam: @genelToplamDec
            };
            var qtyStep = '@NumberFormatHelper.Step(qtyDec)';
            var priceStep = '@NumberFormatHelper.Step(priceDec)';
            var vatRateStep = '@NumberFormatHelper.Step(vatRateDec)';
            var withholdingRateStep = '@NumberFormatHelper.Step(withholdingRateDec)';
            var totalStep = '@NumberFormatHelper.Step(totalDec)';

            function formatAmount(value, decimals) {
                var d = (decimals === undefined || decimals === null) ? 2 : decimals;
                return value.toLocaleString('tr-TR', { minimumFractionDigits: d, maximumFractionDigits: d });
            }

            function buildStockOptionsHtml() {
                var html = '<option value="0">Seçiniz</option>';
                stockOptions.forEach(function (opt) {
                    html += '<option value="' + opt.value + '">' + opt.text + '</option>';
                });
                return html;
            }

            function buildWithholdingOptionsHtml() {
                var html = '<option value="">Yok</option>';
                withholdingOptions.forEach(function (opt) {
                    html += '<option value="' + opt.value + '">' + opt.text + '</option>';
                });
                return html;
            }

            function reindex() {
                var rows = linesBody.querySelectorAll('tr.line-row');
                rows.forEach(function (row, idx) {
                    row.querySelectorAll('[name]').forEach(function (el) {
                        el.name = el.name.replace(/Lines\[\d+\]/, 'Lines[' + idx + ']');
                    });
                });
            }

            function roundValue(value) {
                return Math.round(value * 10000) / 10000;
            }

            function setRowAmounts(row, net, vat, withholding, netVat, total) {
                row.dataset.net = net;
                row.dataset.vat = vat;
                row.dataset.withholding = withholding;
                row.dataset.netVat = netVat;
                row.dataset.total = total;
                row.querySelector('.line-net').textContent = formatAmount(net, kusuratDecimals.net);
                row.querySelector('.line-vat').textContent = formatAmount(vat, kusuratDecimals.vat);
                row.querySelector('.line-withholding-amount').textContent = formatAmount(withholding, kusuratDecimals.withholding);
                row.querySelector('.line-net-vat').textContent = formatAmount(netVat, kusuratDecimals.netVat);
            }

            function recalcRow(row) {
                var qty = parseFloat(row.querySelector('.line-qty').value) || 0;
                var price = parseFloat(row.querySelector('.line-price').value) || 0;
                var vatRate = parseFloat(row.querySelector('.line-vatrate').value) || 0;
                var withholdingRate = parseFloat(row.querySelector('.line-withholding-rate').value) || 0;

                var net = qty * price;
                var vat = net * vatRate / 100;
                var withholding = vat * withholdingRate / 100;
                var netVat = vat - withholding;
                var total = net + netVat;

                setRowAmounts(row, net, vat, withholding, netVat, total);
                row.querySelector('.line-total').value = roundValue(total);

                return { net: net, vat: vat, withholding: withholding, netVat: netVat, total: total };
            }

            function recalcRowFromTotal(row) {
                var total = parseFloat(row.querySelector('.line-total').value) || 0;
                var vatRate = parseFloat(row.querySelector('.line-vatrate').value) || 0;
                var withholdingRate = parseFloat(row.querySelector('.line-withholding-rate').value) || 0;
                var qty = parseFloat(row.querySelector('.line-qty').value) || 0;

                var factor = 1 + (vatRate / 100) * (1 - withholdingRate / 100);
                var net = factor ? total / factor : total;
                var vat = net * vatRate / 100;
                var withholding = vat * withholdingRate / 100;
                var netVat = vat - withholding;

                if (qty) {
                    row.querySelector('.line-price').value = roundValue(net / qty);
                }

                setRowAmounts(row, net, vat, withholding, netVat, total);
            }

            function updateSummary() {
                var totalNet = 0, totalVat = 0, totalWithholding = 0, totalNetVat = 0, totalGross = 0;

                linesBody.querySelectorAll('tr.line-row').forEach(function (row) {
                    totalNet += parseFloat(row.dataset.net) || 0;
                    totalVat += parseFloat(row.dataset.vat) || 0;
                    totalWithholding += parseFloat(row.dataset.withholding) || 0;
                    totalNetVat += parseFloat(row.dataset.netVat) || 0;
                    totalGross += parseFloat(row.dataset.total) || 0;
                });

                var rate = parseFloat(exchangeRateInput.value) || 0;

                document.getElementById('totalNet').textContent = formatAmount(totalNet, kusuratDecimals.malBedeli);
                document.getElementById('totalVat').textContent = formatAmount(totalVat, kusuratDecimals.vat);
                document.getElementById('totalWithholding').textContent = formatAmount(totalWithholding, kusuratDecimals.withholding);
                document.getElementById('totalNetVat').textContent = formatAmount(totalNetVat, kusuratDecimals.netVat);
                document.getElementById('totalGross').textContent = formatAmount(totalGross, kusuratDecimals.genelToplam);

                document.getElementById('totalNetTry').textContent = formatAmount(totalNet * rate, kusuratDecimals.malBedeli);
                document.getElementById('totalVatTry').textContent = formatAmount(totalVat * rate, kusuratDecimals.vat);
                document.getElementById('totalWithholdingTry').textContent = formatAmount(totalWithholding * rate, kusuratDecimals.withholding);
                document.getElementById('totalNetVatTry').textContent = formatAmount(totalNetVat * rate, kusuratDecimals.netVat);
                document.getElementById('totalGrossTry').textContent = formatAmount(totalGross * rate, kusuratDecimals.genelToplam);
            }

            function recalcAll() {
                linesBody.querySelectorAll('tr.line-row').forEach(recalcRow);
                updateSummary();
            }

            function bindRowEvents(row) {
                row.querySelectorAll('.line-qty, .line-price, .line-vatrate, .line-withholding-rate').forEach(function (el) {
                    el.addEventListener('input', function () {
                        recalcRow(row);
                        updateSummary();
                    });
                });

                row.querySelector('.line-total').addEventListener('input', function () {
                    recalcRowFromTotal(row);
                    updateSummary();
                });

                row.querySelector('.line-stock').addEventListener('change', function () {
                    var rate = stockVatRates[this.value];
                    if (rate !== undefined) {
                        row.querySelector('.line-vatrate').value = rate;
                    }
                    recalcRow(row);
                    updateSummary();
                });

                row.querySelector('.line-withholding-select').addEventListener('change', function () {
                    var rate = withholdingRates[this.value];
                    row.querySelector('.line-withholding-rate').value = rate !== undefined ? rate : 0;
                    recalcRow(row);
                    updateSummary();
                });

                row.querySelector('.line-remove').addEventListener('click', function () {
                    if (linesBody.querySelectorAll('tr.line-row').length <= 1) return;
                    row.remove();
                    reindex();
                    updateSummary();
                });
            }

            function addRow() {
                var idx = linesBody.querySelectorAll('tr.line-row').length;
                var tr = document.createElement('tr');
                tr.className = 'line-row';
                tr.innerHTML =
                    '<td><input type="hidden" name="Lines[' + idx + '].RecId" value="0" />' +
                    '<select name="Lines[' + idx + '].StockId" class="form-select form-select-sm line-stock">' + buildStockOptionsHtml() + '</select></td>' +
                    '<td><input type="text" name="Lines[' + idx + '].Description" class="form-control form-control-sm" /></td>' +
                    '<td><input type="number" step="' + qtyStep + '" min="0" name="Lines[' + idx + '].Quantity" class="form-control form-control-sm text-end line-qty" value="0" /></td>' +
                    '<td><input type="number" step="' + priceStep + '" min="0" name="Lines[' + idx + '].UnitPrice" class="form-control form-control-sm text-end line-price" value="0" /></td>' +
                    '<td><input type="number" step="' + vatRateStep + '" min="0" name="Lines[' + idx + '].VatRate" class="form-control form-control-sm text-end line-vatrate" value="0" /></td>' +
                    '<td><select name="Lines[' + idx + '].WithholdingDefinitionId" class="form-select form-select-sm line-withholding-select">' + buildWithholdingOptionsHtml() + '</select></td>' +
                    '<td><input type="number" step="' + withholdingRateStep + '" min="0" max="100" name="Lines[' + idx + '].WithholdingRate" class="form-control form-control-sm text-end line-withholding-rate" value="0" /></td>' +
                    '<td class="text-end line-net">0,00</td>' +
                    '<td class="text-end line-vat">0,00</td>' +
                    '<td class="text-end line-withholding-amount">0,00</td>' +
                    '<td class="text-end line-net-vat">0,00</td>' +
                    '<td><input type="number" step="' + totalStep + '" min="0" class="form-control form-control-sm text-end line-total" value="0" /></td>' +
                    '<td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger line-remove">&times;</button></td>';
                linesBody.appendChild(tr);
                bindRowEvents(tr);
                recalcAll();
            }

            function syncCurrency() {
                currencyLabel.textContent = currencySelect.value;
                if (currencySelect.value === 'TRY') {
                    exchangeRateInput.value = 1;
                    exchangeRateInput.readOnly = true;
                } else {
                    exchangeRateInput.readOnly = false;
                }
                recalcAll();
            }

            linesBody.querySelectorAll('tr.line-row').forEach(bindRowEvents);
            addBtn.addEventListener('click', addRow);
            currencySelect.addEventListener('change', syncCurrency);
            exchangeRateInput.addEventListener('input', recalcAll);

            syncCurrency();
        })();
    </script>
}
