@model YamanCam.Web.Models.AppWorkPlaceEditViewModel
@{
    var isNew = Model.RecId == 0;
    ViewData["Title"] = isNew ? "Yeni Şube" : "Şube Düzenle";
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h4 mb-3">@ViewData["Title"]</h1>

        @if (Model.CompanyOptions.Count == 0)
        {
            <div class="alert alert-warning mb-0">
                Şube tanımlamadan önce <a asp-controller="AppCompanies" asp-action="Create">şirket kaydı</a> oluşturun.
            </div>
        }
        else
        {
            <form asp-action="@(isNew ? "Create" : "Edit")" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="RecId" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="CompanyId" class="form-label"></label>
                        <select asp-for="CompanyId" class="form-select">
                            <option value="">Seçiniz</option>
                            @foreach (var company in Model.CompanyOptions)
                            {
                                if (Model.CompanyId == company.CompanyId)
                                {
                                    <option value="@company.CompanyId" selected="selected">@company.DisplayName</option>
                                }
                                else
                                {
                                    <option value="@company.CompanyId">@company.DisplayName</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="CompanyId" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="WorkPlaceCode" class="form-label"></label>
                        <input asp-for="WorkPlaceCode" class="form-control" />
                        <span asp-validation-for="WorkPlaceCode" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="WorkPlaceName" class="form-label"></label>
                        <input asp-for="WorkPlaceName" class="form-control" />
                        <span asp-validation-for="WorkPlaceName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Address" class="form-label"></label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="City" class="form-label"></label>
                        <input asp-for="City" class="form-control" />
                        <span asp-validation-for="City" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                    <div class="col-12 d-flex gap-3">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="IsDefault" name="IsDefault" value="true" @(Model.IsDefault ? "checked" : "") />
                            <label asp-for="IsDefault" class="form-check-label"></label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="IsActive" name="IsActive" value="true" @(Model.IsActive ? "checked" : "") />
                            <label asp-for="IsActive" class="form-check-label"></label>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                    <a asp-action="Index" asp-route-companyId="@Model.CompanyId" class="btn btn-outline-secondary">Vazgeç</a>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
