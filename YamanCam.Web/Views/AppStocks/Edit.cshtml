@model YamanCam.Web.Models.AppStockEditViewModel
@{
    var isNew = Model.RecId == 0;
    ViewData["Title"] = isNew ? "Yeni Stok" : "Stok Düzenle";
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form asp-action="@(isNew ? "Create" : "Edit")" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="RecId" type="hidden" />

            <div class="d-flex justify-content-between align-items-start mb-3">
                <h1 class="h4 mb-0">@ViewData["Title"]</h1>
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="IsActive" name="IsActive" value="true" @(Model.IsActive ? "checked" : "") />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <h2 class="h6 text-muted mb-3">Stok Bilgileri</h2>
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="StockCode" class="form-label"></label>
                    <input asp-for="StockCode" class="form-control" />
                    <span asp-validation-for="StockCode" class="text-danger"></span>
                </div>
                <div class="col-md-9">
                    <label asp-for="StockName" class="form-label"></label>
                    <input asp-for="StockName" class="form-control" />
                    <span asp-validation-for="StockName" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="StockGroupId" class="form-label"></label>
                    <select asp-for="StockGroupId" asp-items="Model.StockGroupOptions" class="form-select">
                        <option value="">Seçiniz</option>
                    </select>
                    <span asp-validation-for="StockGroupId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="StockUnitId" class="form-label"></label>
                    <select asp-for="StockUnitId" asp-items="Model.StockUnitOptions" class="form-select">
                        <option value="">Seçiniz</option>
                    </select>
                    <span asp-validation-for="StockUnitId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Barcode" class="form-label"></label>
                    <input asp-for="Barcode" class="form-control" />
                    <span asp-validation-for="Barcode" class="text-danger"></span>
                </div>
            </div>

            <h2 class="h6 text-muted mt-4 mb-3">KDV ve Diğer Bilgiler</h2>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="PurchaseVatId" class="form-label"></label>
                    <select asp-for="PurchaseVatId" asp-items="Model.VatOptions" class="form-select">
                        <option value="">Seçiniz</option>
                    </select>
                    <span asp-validation-for="PurchaseVatId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="SalesVatId" class="form-label"></label>
                    <select asp-for="SalesVatId" asp-items="Model.VatOptions" class="form-select">
                        <option value="">Seçiniz</option>
                    </select>
                    <span asp-validation-for="SalesVatId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="StockType" class="form-label"></label>
                    <input asp-for="StockType" class="form-control" placeholder="Mamul, Hammadde..." />
                    <span asp-validation-for="StockType" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="ProductionWeight" class="form-label"></label>
                    <input asp-for="ProductionWeight" class="form-control" type="number" step="0.0001" min="0" />
                    <span asp-validation-for="ProductionWeight" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </form>

        @if (!isNew)
        {
            <form asp-action="Delete" asp-route-id="@Model.RecId" method="post" class="mt-3 pt-3 border-top">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="btn btn-outline-danger"
                        onclick="return confirm('Bu stoku silmek istediğinize emin misiniz?');">
                    Stoku Sil
                </button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
