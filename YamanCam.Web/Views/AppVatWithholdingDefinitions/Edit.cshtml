@model YamanCam.Web.Models.AppVatWithholdingDefinitionEditViewModel
@{
    var isNew = Model.RecId == 0;
    ViewData["Title"] = isNew ? "Yeni Tevkifat KDV" : "Tevkifat KDV Düzenle";
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form asp-action="@(isNew ? "Create" : "Edit")" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="RecId" type="hidden" />

            <div class="d-flex justify-content-between align-items-start mb-3">
                <h1 class="h4 mb-0">@ViewData["Title"]</h1>
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="IsActive" name="IsActive" value="true" @(Model.IsActive ? "checked" : "") />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <h2 class="h6 text-muted mb-3">Tevkifat Bilgileri</h2>
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="WithholdingCode" class="form-label"></label>
                    <input asp-for="WithholdingCode" class="form-control" placeholder="TEV0910" />
                    <span asp-validation-for="WithholdingCode" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="WithholdingName" class="form-label"></label>
                    <input asp-for="WithholdingName" class="form-control" placeholder="9/10 Tevkifat" />
                    <span asp-validation-for="WithholdingName" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="VatRate" class="form-label"></label>
                    <input asp-for="VatRate" class="form-control" type="number" step="0.01" min="0" max="100" />
                    <span asp-validation-for="VatRate" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="WithholdingRate" class="form-label"></label>
                    <input asp-for="WithholdingRate" class="form-control" type="number" step="0.01" min="0" max="100" />
                    <span asp-validation-for="WithholdingRate" class="text-danger"></span>
                </div>
            </div>

            <h2 class="h6 text-muted mt-4 mb-3">Muhasebe Kodu</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="AccountCode" class="form-label"></label>
                    <select asp-for="AccountCode" asp-items="Model.AccountCodeOptions" class="form-select">
                        <option value="">Seçiniz</option>
                    </select>
                    <span asp-validation-for="AccountCode" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </form>

        @if (!isNew)
        {
            <form asp-action="Delete" asp-route-id="@Model.RecId" method="post" class="mt-3 pt-3 border-top">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="btn btn-outline-danger"
                        onclick="return confirm('Bu tevkifat KDV tanımını silmek istediğinize emin misiniz?');">
                    Tevkifat KDV Tanımını Sil
                </button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
