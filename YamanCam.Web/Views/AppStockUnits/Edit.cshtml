@model YamanCam.Web.Models.AppStockUnitEditViewModel
@{
    var isNew = Model.RecId == 0;
    ViewData["Title"] = isNew ? "Yeni Birim" : "Birim Düzenle";
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form asp-action="@(isNew ? "Create" : "Edit")" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="RecId" type="hidden" />

            <div class="d-flex justify-content-between align-items-start mb-3">
                <h1 class="h4 mb-0">@ViewData["Title"]</h1>
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="IsActive" name="IsActive" value="true" @(Model.IsActive ? "checked" : "") />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="UnitCode" class="form-label"></label>
                    <input asp-for="UnitCode" class="form-control" placeholder="ADET, KG..." />
                    <span asp-validation-for="UnitCode" class="text-danger"></span>
                </div>
                <div class="col-md-9">
                    <label asp-for="UnitName" class="form-label"></label>
                    <input asp-for="UnitName" class="form-control" placeholder="ADET, KİLOGRAM..." />
                    <span asp-validation-for="UnitName" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </form>

        @if (!isNew)
        {
            <form asp-action="Delete" asp-route-id="@Model.RecId" method="post" class="mt-3 pt-3 border-top">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="btn btn-outline-danger"
                        onclick="return confirm('Bu stok birimini silmek istediğinize emin misiniz?');">
                    Birimi Sil
                </button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
