@model YamanCam.Web.Models.AppProductionVoucherEditViewModel
@using System.Globalization
@{
    var isNew = Model.RecId == 0;
    ViewData["Title"] = isNew ? "Yeni Stok Ürün Üretim Fişi" : "Stok Ürün Üretim Fişi Düzenle";
    var stockOptionsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.StockOptions.Select(o => new { value = o.Value, text = o.Text }));
    var productRawMap = ViewData["ProductRawMaterialMap"] as Dictionary<string, string> ?? new Dictionary<string, string>();
    var productRawMapJson = System.Text.Json.JsonSerializer.Serialize(productRawMap);
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form asp-action="@(isNew ? "Create" : "Edit")" method="post" id="productionVoucherForm">
            @Html.AntiForgeryToken()
            <input asp-for="RecId" type="hidden" />

            <div class="d-flex justify-content-between align-items-start mb-3">
                <h1 class="h4 mb-0">@ViewData["Title"]</h1>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <h2 class="h6 text-muted mb-3">Fiş Bilgileri</h2>
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="VoucherDate" class="form-label"></label>
                    <input asp-for="VoucherDate" type="date" class="form-control" asp-format="{0:yyyy-MM-dd}" />
                    <span asp-validation-for="VoucherDate" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="ProductionDate" class="form-label"></label>
                    <input asp-for="ProductionDate" type="date" class="form-control" asp-format="{0:yyyy-MM-dd}" />
                    <span asp-validation-for="ProductionDate" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="WorkPlaceId" class="form-label"></label>
                    <select asp-for="WorkPlaceId" asp-items="Model.WorkPlaceOptions" class="form-select">
                        <option value="">Seçiniz</option>
                    </select>
                    <span asp-validation-for="WorkPlaceId" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="TransactionType" class="form-label"></label>
                    <select asp-for="TransactionType" asp-items="Model.TransactionTypeOptions" class="form-select"></select>
                    <span asp-validation-for="TransactionType" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="VoucherNo" class="form-label"></label>
                    <input asp-for="VoucherNo" class="form-control" />
                    <span asp-validation-for="VoucherNo" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="SpecialCode" class="form-label"></label>
                    <input asp-for="SpecialCode" class="form-control" />
                    <span asp-validation-for="SpecialCode" class="text-danger"></span>
                </div>
            </div>

            <h2 class="h6 text-muted mt-4 mb-3">Üretim Satırları</h2>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-2" id="linesTable">
                    <thead>
                        <tr>
                            <th style="min-width:240px;">Hammadde Adı</th>
                            <th style="width:130px;" class="text-end">Miktar</th>
                            <th style="width:110px;" class="text-end">Fire Oran %</th>
                            <th style="width:130px;" class="text-end">Miktar (Mamül)</th>
                            <th style="min-width:240px;">Mamul Adı</th>
                            <th style="width:50px;"></th>
                        </tr>
                    </thead>
                    <tbody id="linesBody">
                        @for (var i = 0; i < Model.Lines.Count; i++)
                        {
                            <tr class="line-row">
                                <td>
                                    <input type="hidden" name="Lines[@i].RecId" value="@Model.Lines[i].RecId" />
                                    <select name="Lines[@i].RawMaterialStockId" class="form-select form-select-sm line-raw">
                                        <option value="0">Seçiniz</option>
                                        @foreach (var opt in Model.StockOptions)
                                        {
                                            <option value="@opt.Value" selected="@(opt.Value == Model.Lines[i].RawMaterialStockId.ToString(CultureInfo.InvariantCulture) ? "selected" : null)">@opt.Text</option>
                                        }
                                    </select>
                                </td>
                                <td><input type="number" step="0.0001" min="0" name="Lines[@i].RawMaterialQuantity" class="form-control form-control-sm text-end line-raw-qty" value="@Model.Lines[i].RawMaterialQuantity.ToString(CultureInfo.InvariantCulture)" /></td>
                                <td><input type="number" step="0.01" min="0" max="100" name="Lines[@i].WasteRate" class="form-control form-control-sm text-end line-waste" value="@Model.Lines[i].WasteRate.ToString(CultureInfo.InvariantCulture)" /></td>
                                <td><input type="number" step="0.0001" min="0" name="Lines[@i].ProductQuantity" class="form-control form-control-sm text-end line-prod-qty" value="@Model.Lines[i].ProductQuantity.ToString(CultureInfo.InvariantCulture)" /></td>
                                <td>
                                    <select name="Lines[@i].ProductStockId" class="form-select form-select-sm line-product">
                                        <option value="0">Seçiniz</option>
                                        @foreach (var opt in Model.StockOptions)
                                        {
                                            <option value="@opt.Value" selected="@(opt.Value == Model.Lines[i].ProductStockId.ToString(CultureInfo.InvariantCulture) ? "selected" : null)">@opt.Text</option>
                                        }
                                    </select>
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-outline-danger line-remove">&times;</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="d-flex gap-2 mb-4">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="addLineBtn">Üretim Satır Oluştur</button>
                <button type="button" class="btn btn-sm btn-outline-danger" id="removeLastLineBtn">Satır Sil</button>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </form>

        @if (!isNew)
        {
            <form asp-action="Delete" asp-route-id="@Model.RecId" method="post" class="mt-3 pt-3 border-top">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="btn btn-outline-danger"
                        onclick="return confirm('Bu fişi silmek istediğinize emin misiniz?');">
                    Fişi Sil
                </button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var linesBody = document.getElementById('linesBody');
            var addBtn = document.getElementById('addLineBtn');
            var removeLastBtn = document.getElementById('removeLastLineBtn');
            var stockOptions = @Html.Raw(stockOptionsJson);
            var productRawMap = @Html.Raw(productRawMapJson);

            function buildStockOptionsHtml() {
                var html = '<option value="0">Seçiniz</option>';
                stockOptions.forEach(function (opt) {
                    html += '<option value="' + opt.value + '">' + opt.text + '</option>';
                });
                return html;
            }

            function reindex() {
                var rows = linesBody.querySelectorAll('tr.line-row');
                rows.forEach(function (row, idx) {
                    row.querySelectorAll('[name]').forEach(function (el) {
                        el.name = el.name.replace(/Lines\[\d+\]/, 'Lines[' + idx + ']');
                    });
                });
            }

            function bindRowEvents(row) {
                row.querySelector('.line-product').addEventListener('change', function () {
                    var rawId = productRawMap[this.value];
                    var rawSelect = row.querySelector('.line-raw');
                    if (rawId !== undefined && (!rawSelect.value || rawSelect.value === '0')) {
                        rawSelect.value = rawId;
                    }
                });

                row.querySelector('.line-remove').addEventListener('click', function () {
                    if (linesBody.querySelectorAll('tr.line-row').length <= 1) return;
                    row.remove();
                    reindex();
                });
            }

            function addRow() {
                var idx = linesBody.querySelectorAll('tr.line-row').length;
                var tr = document.createElement('tr');
                tr.className = 'line-row';
                tr.innerHTML =
                    '<td><input type="hidden" name="Lines[' + idx + '].RecId" value="0" />' +
                    '<select name="Lines[' + idx + '].RawMaterialStockId" class="form-select form-select-sm line-raw">' + buildStockOptionsHtml() + '</select></td>' +
                    '<td><input type="number" step="0.0001" min="0" name="Lines[' + idx + '].RawMaterialQuantity" class="form-control form-control-sm text-end line-raw-qty" value="0" /></td>' +
                    '<td><input type="number" step="0.01" min="0" max="100" name="Lines[' + idx + '].WasteRate" class="form-control form-control-sm text-end line-waste" value="0" /></td>' +
                    '<td><input type="number" step="0.0001" min="0" name="Lines[' + idx + '].ProductQuantity" class="form-control form-control-sm text-end line-prod-qty" value="0" /></td>' +
                    '<td><select name="Lines[' + idx + '].ProductStockId" class="form-select form-select-sm line-product">' + buildStockOptionsHtml() + '</select></td>' +
                    '<td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger line-remove">&times;</button></td>';
                linesBody.appendChild(tr);
                bindRowEvents(tr);
            }

            linesBody.querySelectorAll('tr.line-row').forEach(bindRowEvents);
            addBtn.addEventListener('click', addRow);
            removeLastBtn.addEventListener('click', function () {
                var rows = linesBody.querySelectorAll('tr.line-row');
                if (rows.length <= 1) return;
                rows[rows.length - 1].remove();
                reindex();
            });
        })();
    </script>
}
