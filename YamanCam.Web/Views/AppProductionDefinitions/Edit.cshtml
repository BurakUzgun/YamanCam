@model YamanCam.Web.Models.AppProductionDefinitionEditViewModel
@{
    var isNew = Model.RecId == 0;
    ViewData["Title"] = isNew ? "Yeni Üretim Tanımı" : "Üretim Tanımı Düzenle";
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form asp-action="@(isNew ? "Create" : "Edit")" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="RecId" type="hidden" />

            <div class="d-flex justify-content-between align-items-start mb-3">
                <h1 class="h4 mb-0">@ViewData["Title"]</h1>
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="IsActive" name="IsActive" value="true" @(Model.IsActive ? "checked" : "") />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="WorkPlaceId" class="form-label"></label>
                    <select asp-for="WorkPlaceId" asp-items="Model.WorkPlaceOptions" class="form-select">
                        <option value="">Seçiniz...</option>
                    </select>
                    <span asp-validation-for="WorkPlaceId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="ProductStockId" class="form-label"></label>
                    <select asp-for="ProductStockId" asp-items="Model.StockOptions" class="form-select">
                        <option value="">Seçiniz...</option>
                    </select>
                    <span asp-validation-for="ProductStockId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="RawMaterialStockId" class="form-label"></label>
                    <select asp-for="RawMaterialStockId" asp-items="Model.StockOptions" class="form-select">
                        <option value="">Seçiniz...</option>
                    </select>
                    <span asp-validation-for="RawMaterialStockId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="ProductionQuantity" class="form-label"></label>
                    <input asp-for="ProductionQuantity" class="form-control" type="number" step="0.0001" min="0" />
                    <span asp-validation-for="ProductionQuantity" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </form>

        @if (!isNew)
        {
            <form asp-action="Delete" asp-route-id="@Model.RecId" method="post" class="mt-3 pt-3 border-top">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="btn btn-outline-danger"
                        onclick="return confirm('Bu üretim tanımını silmek istediğinize emin misiniz?');">
                    Üretim Tanımını Sil
                </button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
